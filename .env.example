# Anthropic API key used by api/plan-trip.ts to run the trip-planning agent.
ANTHROPIC_API_KEY=

# Duffel flight search API token. Use a sandbox/test token (prefixed
# "duffel_test_...") — it returns mock airline offers with no real bookings
# and no live-pricing cost, which is all this demo needs.
DUFFEL_ACCESS_TOKEN=
